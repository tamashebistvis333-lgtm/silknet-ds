{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "silknet-ds/design-governance/layout-governance.schema.json",
  "title": "Registry r8 layout governance",
  "description": "Validates only the r8 additions to component-registry.json: layoutSchemaVersion, and per-component `layout` and `contentConstraints`. r7 fields are left to the registry template and are not constrained here. Checked by design-governance/scripts/validate-registry.mjs (supports exactly the keywords used in this file).",
  "type": "object",
  "required": ["layoutSchemaVersion", "components"],
  "properties": {
    "layoutSchemaVersion": { "const": 1 },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "layout": { "$ref": "#/$defs/layout" },
          "contentConstraints": { "type": "array", "items": { "$ref": "#/$defs/contentConstraint" } }
        }
      }
    }
  },
  "$defs": {
    "sizingMode": { "enum": ["HUG", "FIXED"] },
    "nativeSizing": {
      "type": "object",
      "required": ["horizontal", "vertical", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "horizontal": { "$ref": "#/$defs/sizingMode" },
        "vertical": { "$ref": "#/$defs/sizingMode" },
        "width": { "type": ["number", "null"], "minimum": 0 },
        "height": { "type": ["number", "null"], "minimum": 0 }
      },
      "allOf": [
        {
          "if": { "properties": { "horizontal": { "const": "FIXED" } } },
          "then": { "properties": { "width": { "type": "number" } } },
          "else": { "properties": { "width": { "type": "null" } } }
        },
        {
          "if": { "properties": { "vertical": { "const": "FIXED" } } },
          "then": { "properties": { "height": { "type": "number" } } },
          "else": { "properties": { "height": { "type": "null" } } }
        }
      ]
    },
    "fillContext": {
      "type": "object",
      "required": ["id", "parentType", "parentLayoutMode", "parentLayoutWrap", "parentCounterAxisAlignItems", "childLayoutPositioning", "testedInnerWidth", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^ctx\\.[a-z0-9.-]+$" },
        "parentType": { "const": "FRAME" },
        "parentLayoutMode": { "const": "VERTICAL" },
        "parentLayoutWrap": { "const": "NO_WRAP" },
        "parentCounterAxisAlignItems": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["MIN", "CENTER", "MAX"] } },
        "childLayoutPositioning": { "const": "AUTO" },
        "testedInnerWidth": {
          "type": "object",
          "required": ["min", "max"],
          "additionalProperties": false,
          "properties": { "min": { "type": "number", "minimum": 0 }, "max": { "type": "number", "minimum": 0 } }
        },
        "evidence": { "type": "string", "minLength": 1 }
      }
    },
    "approvalComplete": {
      "type": "object",
      "required": ["by", "quote", "at", "scope"],
      "additionalProperties": false,
      "properties": {
        "by": { "type": "string", "minLength": 1 },
        "quote": { "type": "string", "minLength": 1 },
        "at": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}" },
        "scope": { "type": "string", "minLength": 1 }
      }
    },
    "layout": {
      "type": "object",
      "required": ["status", "nativeByVariant", "horizontal", "vertical", "fill", "verification", "approval"],
      "additionalProperties": false,
      "properties": {
        "status": { "enum": ["proposed", "approved", "blocked"] },
        "nativeByVariant": { "type": "object", "minProperties": 1, "additionalProperties": { "$ref": "#/$defs/nativeSizing" } },
        "horizontal": {
          "type": "object",
          "required": ["allowed"],
          "additionalProperties": false,
          "properties": {
            "allowed": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["NATIVE", "FILL"] }, "contains": { "const": "NATIVE" } }
          }
        },
        "vertical": {
          "type": "object",
          "required": ["allowed"],
          "additionalProperties": false,
          "properties": { "allowed": { "const": ["NATIVE"] } }
        },
        "fill": {
          "type": "object",
          "required": ["variantCombinations", "contexts", "extraOverrideFields"],
          "additionalProperties": false,
          "properties": {
            "variantCombinations": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
            "contexts": { "type": "array", "items": { "$ref": "#/$defs/fillContext" } },
            "extraOverrideFields": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
          }
        },
        "verification": {
          "type": "object",
          "required": ["capabilityTest", "PASS", "UNVERIFIED"],
          "additionalProperties": false,
          "properties": {
            "capabilityTest": { "type": "string", "minLength": 1 },
            "PASS": { "type": "array", "items": { "type": "string" } },
            "UNVERIFIED": { "type": "array", "items": { "type": "string" } }
          }
        },
        "approval": { "type": ["object", "null"] }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "approved" } } },
          "then": { "properties": { "approval": { "$ref": "#/$defs/approvalComplete" } } },
          "else": { "properties": { "approval": { "type": "null" } } }
        }
      ]
    },
    "contentConstraint": {
      "type": "object",
      "required": ["id", "property", "textLayerByVariant", "kind", "maxLines", "onViolation", "status", "dsIssue", "evidence"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^C-[A-Z0-9-]+$" },
        "property": { "type": "string", "minLength": 1 },
        "textLayerByVariant": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": ["string", "null"], "pattern": "^\\d+:\\d+(;\\d+:\\d+)*$" }
        },
        "containerLayerByVariant": {
          "type": "object",
          "additionalProperties": { "type": ["string", "null"], "pattern": "^\\d+:\\d+(;\\d+:\\d+)*$" }
        },
        "kind": { "enum": ["SINGLE_LINE", "MAX_LINES", "FIT_CONTAINER"] },
        "maxLines": { "type": ["integer", "null"], "minimum": 1 },
        "onViolation": { "enum": ["VISUAL_DEFECT", "UNVERIFIED"] },
        "status": { "enum": ["verified-limitation", "unverified"] },
        "dsIssue": { "type": ["string", "null"], "pattern": "^DS-\\d{2}$" },
        "evidence": { "type": "string", "minLength": 1 }
      },
      "allOf": [
        {
          "if": { "properties": { "kind": { "const": "MAX_LINES" } } },
          "then": { "properties": { "maxLines": { "type": "integer" } } },
          "else": { "properties": { "maxLines": { "type": "null" } } }
        }
      ]
    }
  }
}
